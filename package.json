{
  "name": "omnipanel",
  "productName": "OmniPanel",
  "version": "2.0.0",
  "description": "A virtual joystick controller hosted on your local network.",
  "author": "Max Wissink",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node node_scripts/download-python-env.js"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-forge": "^1.3.3",
    "ws": "^8.18.3"
  },
  "build": {
    "appId": "com.maxwissink.omnipanel",
    "asar": true,
    "asarUnpack": [
      "python-env/**/*",
      "app/program/python/**/*"
    ],
    "files": [
      "**/*",
      "!dist${/*}",
      "!node_scripts${/*}",
      "!python-env/windows${/*}",
      "!python-env/linux${/*}"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["zip", "dir"],
      "files": [
        "python-env/windows/**/*"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["zip", "dir"],
      "category": "Utility",
      "files": [
        "python-env/linux/**/*"
      ]
    },
    "extraFiles": [
      "config.json",
      "user/"
    ]
  }
}