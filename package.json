{
  "name": "omnipanel",
  "version": "1.0.0",
  "description": "",
  "main": "app/main.js",
  "scripts": {
    "start": "electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-forge": "^1.3.3",
    "ws": "^8.18.3"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "python-env/**/*",
      "app/program/python/**/*"
    ],
    "win": {
      "extraResources": [
        {
          "from": "python-env/windows/",
          "to": "python-env/windows/"
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "python-env/linux/",
          "to": "python-env/linux/"
        }
      ]
    },
    "extraFiles": [
      "config.json",
      "user/"
    ]
  }
}