{
  "name": "omnipanel",
  "productName": "OmniPanel",
  "version": "1.0.0",
  "description": "A virtual joystick controller hosted on your local network.",
  "author": "Max Wissink",
  "main": "app/main.js",
  "scripts": {
    "start": "electron ."
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-forge": "^1.3.3",
    "ws": "^8.18.3"
  },
  "build": {
    "appId": "com.maxwissink.omnipanel",
    "asar": true,
    "asarUnpack": [
      "python-env/**/*",
      "app/program/python/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "python-env/windows/",
          "to": "python-env/windows/"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "extraResources": [
        {
          "from": "python-env/linux/",
          "to": "python-env/linux/"
        }
      ]
    },
    "extraFiles": [
      "config.json",
      "user/"
    ]
  }
}